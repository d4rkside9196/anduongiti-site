APP_NAME="An Duong ITI"
# Production template. For local dev, copy → .env, set APP_ENV=local, APP_DEBUG=true, APP_KEY=base64:<run php artisan key:generate>, APP_URL=http://localhost.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://anduongiti.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────
# MySQL only. For local dev, create the database and user first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anduongiti
DB_USERNAME=anduongiti
DB_PASSWORD=

# ── Sessions ─────────────────────────────────────────────────────────
# In production over HTTPS, set SESSION_SECURE_COOKIE=true so the
# session cookie is only sent over TLS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Hostinger SMTP) ────────────────────────────────────────────
# Production template defaults to SMTP: the app refuses to boot when
# APP_ENV=production with MAIL_MAILER=log (AppServiceProvider guard), so
# fill in a real mailbox before go-live. Local dev overrides MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@anduongiti.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@anduongiti.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial admin user — used ONCE by database seeder.
# Generate a strong password and change it via /admin after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
